rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == "minhalojinhatech@gmail.com";
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/.*');
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner() && isImage() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner();
    }

    match /demand-models/{modelId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner() && isImage() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner();
    }

    match /hero/{fileName} {
      allow read: if true;
      allow create, update: if isOwner() && isImage() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner();
    }

    match /reviews/{reviewId}/{fileName} {
      allow read: if true;
      allow create: if isImage() && request.resource.size < 8 * 1024 * 1024;
      allow update, delete: if isOwner();
    }

    match /requests/{userId}/{requestId}/{fileName} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if isOwner();
    }

    match /users/{userId}/{fileName} {
      allow read, write: if isOwner() || (signedIn() && request.auth.uid == userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
